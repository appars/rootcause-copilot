# RootCause Copilot - example environment variables. PLACEHOLDERS ONLY.
# Copy to .env only if you need it; .env is git-ignored. NEVER commit a real key.
#
# The recommended way for students is to paste your key in the app: Settings -> "Your Groq API key".
# The app does NOT load this file automatically. If you want a server-side key, set it in your shell:
#   PowerShell (current window only):  $env:GROQ_API_KEY = Read-Host "Groq key"
#   macOS/Linux (current shell only):  read -s GROQ_API_KEY && export GROQ_API_KEY
GROQ_API_KEY=your_groq_api_key_here

# Optional: where SQLite incident memory is stored (default: ./data_store)
# ROOTCAUSE_DATA_DIR=./data_store
